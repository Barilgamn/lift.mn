# Серверийн тохиргоо. Энэ файлыг .env нэрээр хуулж, утгыг нь бөглөнө.
# .env файлыг git-д хийхгүй (.gitignore-д орсон).

# API серверийн порт
PORT=3001

# SQLite өгөгдлийн сангийн байршил
DATABASE_PATH=./data/lift.db

# Production дээр заавал production болгоно — cookie зөвхөн HTTPS-ээр явна
NODE_ENV=development
