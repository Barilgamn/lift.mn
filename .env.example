# Supabase-ийн тохиргоо.
# Энэ файлыг .env нэрээр хуулж, өөрийн төслийн утгаар солино.
# .env файл git-д ордоггүй (.gitignore-д орсон).
#
# Түлхүүрүүдээ Supabase Dashboard -> Project Settings -> API Keys
# хуудасны "Publishable and secret API keys" таб дээрээс авна.

# --- Хөтөч рүү илгээгддэг (нууц БИШ) ---
# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# API Keys -> Publishable key -> default
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- ЗӨВХӨН энэ компьютер дээр, терминалын скриптэд ---
# API Keys -> Secret keys -> default (нүдний тэмдэг дарж харна)
# Энэ түлхүүр өгөгдлийн сангийн бүх хамгаалалтыг тойрдог.
# Хэнд ч дамжуулж болохгүй, хөтчийн код дотор бүү бич.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Хуучин хэлбэрийн түлхүүр (заавал биш) ---
# "Legacy anon, service_role API keys" таб дээрх JWT түлхүүрүүд.
# Дээрх шинэ хэлбэр байхгүй үед л эдгээрийг ашиглана.
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
